<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_available_products">

    <fragment
        android:id="@+id/navigation_available_products"
        android:name="com.example.foodfund.ui.home.AvailableProductsFragment"
        android:label="@string/title_available_products"
        tools:layout="@layout/fragment_available_products" />

    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.example.foodfund.ui.dashboard.DashboardFragment"
        android:label="@string/title_dashboard"
